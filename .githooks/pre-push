#!/bin/sh
# Pre-push safety net: never let code that fails the TypeScript check reach
# origin (Vercel deploys master automatically). Versioned in .githooks/ so
# every clone/session shares it; activated once per clone with:
#   git config core.hooksPath .githooks
echo "pre-push: npx tsc --noEmit ..."
npx tsc --noEmit
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "❌ Type-check failed — push aborted. Fix the errors above and push again."
  exit $status
fi
echo "✓ type-check passed"

# A stale sitemap <lastmod> is invisible everywhere except a search result weeks
# later. It already cost us once: the landing date sat at 10/8 while the fix that
# stops therapist names being quoted shipped on 22/8, so Google re-crawled some
# city pages and not others. The comment asking humans to remember did not
# survive three commits, so the check runs here instead.
echo "pre-push: node scripts/check-page-revised.mjs ..."
node scripts/check-page-revised.mjs
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "❌ Sitemap revision dates are stale — push aborted. See above."
  exit $status
fi
exit 0
